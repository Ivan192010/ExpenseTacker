# Copy to .env for local development (`npx expo start`).
# For APK builds, set EXPO_PUBLIC_API_URL in eas.json instead.

# Android emulator -> your PC's localhost is 10.0.2.2. On a real phone use your PC's LAN IP or the Railway URL.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

EXPO_PUBLIC_CURRENCY=MXN
EXPO_PUBLIC_LOCALE=es-MX

# Optional: powers the "Who is using this phone?" toggle on the login screen
# so only the password needs typing. Leave empty to show a plain email field.
EXPO_PUBLIC_USER_A_NAME=Ivan
EXPO_PUBLIC_USER_A_EMAIL=you@example.com
EXPO_PUBLIC_USER_B_NAME=Partner
EXPO_PUBLIC_USER_B_EMAIL=partner@example.com
