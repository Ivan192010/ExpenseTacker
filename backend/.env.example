# Railway sets DATABASE_URL automatically when you reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/couplecount

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_DAYS=30
MAX_DEVICES_PER_USER=2
APP_TIMEZONE=America/Mexico_City

# The two accounts (created on every boot if missing). Passwords max 72 bytes.
SEED_USER_A_NAME=Ivan
SEED_USER_A_EMAIL=you@example.com
SEED_USER_A_PASSWORD=change-me
SEED_USER_B_NAME=Partner
SEED_USER_B_EMAIL=partner@example.com
SEED_USER_B_PASSWORD=change-me-too
# SEED_RESET_PASSWORDS=true
